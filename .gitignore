# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Playwright MCP (Claude Code browser automation — screenshots, logs) ───────
.playwright-mcp/

# ── Playwright test artifacts ─────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Convex generated files ────────────────────────────────────────────────────
convex/_generated/

# ── Cloudflare Worker ─────────────────────────────────────────────────────────
worker/node_modules/
.wrangler/
worker/.wrangler/

# ── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.*

# ── Neorgon base (enforced by smoke check 20) ─────────────────────────────────
!.env.example
.forge/
__pycache__/
*.py[cod]
skills-archived/
*.log

# ── Claude Code local settings ───────────────────────────────────────────────
# Personal, machine-local permissions and paths. Shared settings belong in
# .claude/settings.json.
.claude/settings.local.json

# ── Cloudflare Worker ────────────────────────────────────────────────────────
# wrangler's local state and the Worker's dev secrets.
.dev.vars*
